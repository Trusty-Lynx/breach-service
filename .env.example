# Vorlage für .env – echte Werte nie committen. Die .env liegt nur auf dem Server (/opt/trustylynx/breach-service/.env).
# Werte mit $ in einfache Anführungszeichen setzen, sonst ersetzt Docker Compose den Rest als Variable.

# Für den Auth-Service (Login-Token prüfen, POST /internal/sessions/verify). Er kennt dafür nur den Gateway-Token,
# deshalb derselbe Wert wie SERVICE_TOKEN_GATEWAY im Auth-Service. Pflicht, sonst startet der Service nicht.
SERVICE_TOKEN_GATEWAY=''

# Für den Vault-Service (Tresor entsperrt?, POST /internal/vault/unlocked). Gleicher Wert wie SERVICE_TOKEN_BREACH
# im Vault-Service. Pflicht, sonst startet der Service nicht.
SERVICE_TOKEN_BREACH=''

# Optional, Default: http://auth-service:8080 (Container im trustylynx-net). Lokal: http://localhost:7491
# AUTH_SERVICE_URL=http://auth-service:8080

# Optional, Default: http://vault-service:8080 (Container im trustylynx-net). Lokal: http://localhost:7493
# VAULT_SERVICE_URL=http://vault-service:8080

# Optional, Default: https://leakcheck.io (Public API, ohne API-Key).
# LEAKCHECK_URL=https://leakcheck.io

# Optional: Browser-Origins für CORS, kommagetrennt. http://localhost:<port> und http://127.0.0.1:<port> sind immer erlaubt.
# VORÜBERGEHEND: Nicht gesetzt = jede Origin erlaubt (siehe common/Cors.kt, allowAnyOrigin).
# CORS_ALLOWED_ORIGINS=https://app.nexvent.de

# Optional, Default: false. Erlaubt Origin "null" (Frontend per Doppelklick als Datei geöffnet).
# Nur lokal, auf dem Server immer false: "null" kann auch von sandboxed iframes jeder Website kommen.
# CORS_ALLOW_NULL_ORIGIN=false
