# Template for .env, never commit real values. The .env only lives on the server (/opt/trustylynx/breach-service/.env).
# Put values containing $ in single quotes, otherwise Docker Compose treats the rest as a variable.

# For the auth-service (verify login tokens, POST /internal/sessions/verify). It only accepts the gateway token there,
# so same value as SERVICE_TOKEN_GATEWAY in the auth-service. Required, otherwise the service doesn't start.
SERVICE_TOKEN_GATEWAY=''

# For the vault-service (vault unlocked?, POST /internal/vault/unlocked). Same value as SERVICE_TOKEN_BREACH
# in the vault-service. Required, otherwise the service doesn't start.
SERVICE_TOKEN_BREACH=''

# Optional, default: http://auth-service:8080 (container in trustylynx-net). Locally: http://localhost:7491
# AUTH_SERVICE_URL=http://auth-service:8080

# Optional, default: http://vault-service:8080 (container in trustylynx-net). Locally: http://localhost:7493
# VAULT_SERVICE_URL=http://vault-service:8080

# Optional, default: https://leakcheck.io (public API, no API key).
# LEAKCHECK_URL=https://leakcheck.io

# Optional: additional browser origins for CORS, comma separated. The website https://trustylynx.nexvent.de,
# http://localhost:<port> and http://127.0.0.1:<port> always work, so on the server this stays unset.
# CORS_ALLOWED_ORIGINS=https://staging.example.de

# Optional, default: false. Allows origin "null" (frontend opened as a file by double click).
# Local only, always false on the server: "null" can also come from sandboxed iframes of any website.
# CORS_ALLOW_NULL_ORIGIN=false
